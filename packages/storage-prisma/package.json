{
  "name": "@time-fit/storage-prisma",
  "version": "0.0.0",
  "private": true,
  "description": "Injected Prisma storage ports for @time-fit/core",
  "type": "module",
  "license": "BSD-3-Clause",
  "types": "./types/index.d.ts",
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "default": "./src/index.js"
    }
  },
  "files": [
    "src",
    "types",
    "prisma",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "yarn prisma:generate:test && cross-env NODE_OPTIONS=--experimental-vm-modules jest",
    "test:coverage": "yarn prisma:generate:test && cross-env NODE_OPTIONS=--experimental-vm-modules jest --coverage",
    "prisma:generate:test": "prisma generate --schema __test__/schema.prisma",
    "build:types": "tsc --project tsconfig.types.json",
    "prepack": "yarn build:types",
    "postpack": "node -e \"require('node:fs').rmSync('types', { recursive: true, force: true })\""
  },
  "peerDependencies": {
    "@prisma/client": "^6.5.0",
    "@time-fit/core": ">=0.0.0 <1"
  },
  "devDependencies": {
    "@prisma/client": "6.10.0",
    "@time-fit/core": "workspace:*",
    "cross-env": "^7.0.3",
    "jest": "^29.7.0",
    "prisma": "^6.5.0"
  }
}
